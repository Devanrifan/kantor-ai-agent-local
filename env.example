# Salin jadi .env lalu isi. JANGAN commit file .env.

# Wajib untuk mode live. Kosongkan = mode demo (jawaban contoh, gratis).
ANTHROPIC_API_KEY=

# Kode yang harus dimasukkan pengunjung sebelum bisa chat. WAJIB diisi kalau situs publik.
ACCESS_CODE=

PORT=3001

# Model: leader pakai yang lebih pintar, anggota tim pakai yang lebih murah.
LOCAL_LLM_URL=http://127.0.0.1:8080/v1 
MODEL_LEADER=local:qwen3-4b
MODEL_TEAM=local:qwen3-4b

# Pengaman biaya
MAX_TOKENS=350
RATE_PER_MINUTE=15
DAILY_MAX_REQUESTS=300

# ---- Model lokal (llama-server / LM Studio / Ollama), gratis ----
# Awali nama model dengan "local:". ANTHROPIC_API_KEY boleh kosong kalau semua lokal.
# MODEL_LEADER=local:qwen3-4b
# MODEL_TEAM=local:qwen3-4b
LOCAL_LLM_URL=http://127.0.0.1:8080/v1   # LM Studio: http://127.0.0.1:1234/v1 | Ollama: http://127.0.0.1:11434/v1
LOCAL_NO_THINK=1                          # 1 = matikan mode thinking Qwen3 supaya cepat
# Disarankan untuk CPU: MAX_TOKENS=700
